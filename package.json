{
  "name": "claude-fable-code-review",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web -c auto \"npm run server\" \"npm run serve\"",
    "serve": "ng serve",
    "server": "tsx watch server/index.ts",
    "dev": "npm start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
